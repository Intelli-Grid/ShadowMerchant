# Allow post-install build scripts for packages that require native compilation.
# Without this, pnpm v10+ fails with ERR_PNPM_IGNORED_BUILDS in CI.
# See: https://pnpm.io/cli/approve-builds
onlyBuiltDependencies[]=@clerk/shared
onlyBuiltDependencies[]=@sentry/cli
onlyBuiltDependencies[]=msw
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver
