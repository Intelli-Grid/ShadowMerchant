**Step 4b — New file:** `apps/web/src/app/api/deals/[id]/click/route.ts`
```typescript
import { connectDB } from '@/lib/db';
import DealModel from '@/models/Deal';
import { NextResponse } from 'next/server';

const VELOCITY_THRESHOLD = 30;
const NOTIFY_GAP_MS = 2 * 60 * 60 * 1000;

export async function POST(req: Request, { params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  await connectDB();
  const deal = await DealModel.findByIdAndUpdate(
    id,
    { $inc: { click_count_1h: 1, click_count: 1 } },
    { new: true }
  );
  if (!deal) return NextResponse.json({ ok: false }, { status: 404 });

  const shouldNotify =
    deal.click_count_1h >= VELOCITY_THRESHOLD &&
    (!deal.last_velocity_check ||
      Date.now() - deal.last_velocity_check.getTime() > NOTIFY_GAP_MS);

  if (shouldNotify) {
    // TODO: call telegram notifier for trending alert
    await DealModel.findByIdAndUpdate(id, { last_velocity_check: new Date() });
  }
  return NextResponse.json({ ok: true });
}
```

