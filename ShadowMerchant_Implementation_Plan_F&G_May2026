// Static param generation:
export async function generateStaticParams() {
  const categories = ['sneakers', 'earphones', 'moisturizer', 'gaming-mouse',
                      'laptop', 'phone', 'headphones', 'watch', 'bag'];
  const pricePoints = ['500', '1000', '1500', '2000', '3000', '5000', '10000'];
  return categories.flatMap(category =>
    pricePoints.map(price => ({ category, price }))
  );
}

export async function generateMetadata({ params }) {
  const { category, price } = await params;
  const month = new Date().toLocaleString('en-IN', { month: 'long' });
  const year = new Date().getFullYear();
  return {
    title: `Best ${category} Under ₹${price} in India (${month} ${year}) | ShadowMerchant`,
    description: `Verified deals on ${category} under ₹${price}, ranked by Shadow Score — real savings cross-checked against 30-day price history.`,
  };
}
